# secrets and local tooling
.env
.idea/
__pycache__/
*.py[cod]

# run outputs and caches, regenerated by the harness and the smokes. logs/<run_id>/ holds
# every run's log.jsonl, prompt-response-pairs.jsonl and metadata.json (utils.run_dir);
# tmp.json is the batch checkpoint (CLASS_INDEX_TMP_FILE)
ablation/
logs/
tmp.json
collaborators/
rollouts/

# smokes: the scripts and the ablation class lists are tracked, their outputs are not
smokes/*
!smokes/*.py
!smokes/ablation_classes*.json
